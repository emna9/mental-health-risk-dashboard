# Copy to .env for local or self-hosted runs.

# Address the dashboard uses to reach the FastAPI backend (server-side).
BACKEND_URL=http://127.0.0.1:8000

# Where the backend listens inside the container / host.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Public port for the dashboard. Platforms such as Render inject PORT.
PORT=8501

# Comma-separated browser origins allowed by the API's CORS policy.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

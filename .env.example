# Copy to .env for local or self-hosted runs.

# Address the dashboard uses to reach the FastAPI backend (server-side).
# Accepts a full URL or a bare hostname.
BACKEND_URL=http://127.0.0.1:8000

# full = API + dashboard in one container, api = API only, ui = dashboard only.
APP_MODE=full

# Seconds to wait for the backend, including cold starts on free hosts.
BACKEND_TIMEOUT=90

# Optional: keep the API awake on free hosting by pinging its own public URL.
# Render injects RENDER_EXTERNAL_URL automatically.
KEEP_WARM=0
KEEP_WARM_INTERVAL=600

# Where the backend listens inside the container / host.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Public port for the dashboard. Platforms such as Render inject PORT.
PORT=8501

# Comma-separated browser origins allowed by the API's CORS policy.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
